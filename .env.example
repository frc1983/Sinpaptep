# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env não deve ser commitado.

# Banco de dados
# Local (XAMPP): mysql:host=127.0.0.1;port=3306;dbname=sinpaptep;charset=utf8mb4
# Locaweb (remoto): mysql:host=HOST;port=3306;dbname=sinpaptep;charset=utf8mb4
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=sinpaptep;charset=utf8mb4
DB_USERNAME=sinpaptep
DB_PASSWORD=

# E-mail (true = grava em arquivo, não envia)
MAILER_USE_FILE_TRANSPORT=false
MAILER_DSN=smtp://usuario:senha@smtp.gmail.com:587

# Chaves de cookie (use as mesmas de produção para não deslogar usuários)
COOKIE_VALIDATION_KEY_FRONTEND=
COOKIE_VALIDATION_KEY_BACKEND=
